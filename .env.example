# Copy to .env in the repo root. The API reads this file on startup.

DATABASE_URL=sqlite:////ABSOLUTE/PATH/apps/api/nftstudio.db
STORAGE_DIR=
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EMBED_WORKER=1
FORCE_SYNC=0
SEED_DEMO=1
ALLOW_PLAN_SWITCH=1
REDIS_URL=
CELERY_ENABLED=0
AI_ENDPOINT=
MAX_UPLOAD_MB=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
